              "pm.test('Response matches OpenAPI schema',()=>pm.response.to.have.jsonSchema({\"type\":\"object\",\"properties\":{\"token\":{\"type\":\"string\"},\"customer\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":1},\"name\":{\"type\":\"string\",\"minLength\":2,\"maxLength\":100},\"email\":{\"type\":\"string\",\"minLength\":3,\"maxLength\":150},\"address\":{\"type\":\"string\",\"minLength\":5,\"maxLength\":255},\"phone\":{\"type\":\"string\",\"pattern\":\"^\\\\+?[0-9]{9,15}$\",\"minLength\":9,\"maxLength\":16}},\"required\":[\"id\",\"name\",\"email\",\"address\",\"phone\"]},\"role\":{\"type\":\"string\",\"enum\":[\"CUSTOMER\",\"ADMIN\"]},\"expiresAt\":{\"type\":\"string\"}},\"required\":[\"token\",\"customer\",\"role\",\"expiresAt\"]}));",
